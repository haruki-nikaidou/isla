{
  "db_name": "PostgreSQL",
  "query": "-- The children of a segment-tree node: the level-($2 - 1) nodes whose\n-- cumulative-distance span falls inside the parent's [$3, $4) range. These are\n-- combined (the summary monoid) to produce the parent's summary.\nSELECT\n    id,\n    conversation_id,\n    level,\n    bucket,\n    covers_from_message_id,\n    covers_to_message_id,\n    distance_from,\n    distance_to,\n    summary,\n    is_open,\n    last_summary_children,\n    updated_at\nFROM memory.conversation_summary_node\nWHERE conversation_id = $1\n  AND level = $2 - 1\n  AND distance_from >= $3\n  AND distance_to   <= $4\nORDER BY bucket ASC\n",
