  "query": "\n            SELECT\n                id,\n                opening_summary,\n                closing_summary,\n                created_at,\n                updated_at,\n                privacy AS \"privacy: PrivacyControlFlag\"\n            FROM memory.conversation\n            ORDER BY updated_at DESC\n            LIMIT $1 OFFSET $2\n            ",
