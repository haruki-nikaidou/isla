{
  "db_name": "PostgreSQL",
  "query": "-- Nearest embeddings to a query vector ($1) by cosine distance, restricted to\n-- the audience-allowed privacy levels ($2), limited to $3 rows. Returns the\n-- source reference so callers can resolve the underlying memory entry.\nSELECT\n    id,\n    calender_event,\n    conversation,\n    contact,\n    diary,\n    privacy AS \"privacy: PrivacyControlFlag\",\n    content,\n    (embedding <=> $1) AS \"distance!\"\nFROM memory.embedding\nWHERE embedding IS NOT NULL\n  AND privacy = ANY($2)\nORDER BY embedding <=> $1\nLIMIT $3\n",
