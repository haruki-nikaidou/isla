{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                id,\n                calendar_id,\n                title,\n                description,\n                start_at,\n                deadline,\n                status AS \"status: CalenderTaskStatus\",\n                status_update_at,\n                privacy AS \"privacy: PrivacyControlFlag\"\n            FROM memory.calender_task\n            WHERE calendar_id = $1\n              AND ($2::memory.calender_task_status IS NULL OR status = $2)\n            ORDER BY deadline ASC\n            LIMIT $3 OFFSET $4\n            ",
